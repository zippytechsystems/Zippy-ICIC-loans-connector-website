# Zippy ICICI Loan Connector - Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated or * for development)
# In production specify exact domains, e.g.: https://mintcream-coyote-409919.hostingersite.com,https://zippyloans.in
CORS_ORIGIN=*

# Database Configuration
# Supported drivers: sqlite (built-in zero-config) | postgres (via DATABASE_URL)
DATABASE_CLIENT=sqlite
DATABASE_PATH=./data/zippy_loans.db

# Optional External PostgreSQL Connection (for cloud / enterprise deployments)
# DATABASE_URL=postgresql://db_user:secure_password@localhost:5432/zippy_loans

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=30

# Official Business Contact Metadata (for automated validation and message building)
BUSINESS_PHONE=+916302690251
BUSINESS_WHATSAPP=916302690251
BUSINESS_EMAIL=zippyloanconnector2@gmail.com
